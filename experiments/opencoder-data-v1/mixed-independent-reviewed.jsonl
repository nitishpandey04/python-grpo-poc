{"task_id": "opencoder/9855304006", "source_seq_id": 9855304006, "instruction": "Write a function to find the transpose of a given matrix.", "reference": "def transpose_matrix(matrix):\n    return [list(i) for i in zip(*matrix)]", "entry_point": "transpose_matrix", "signature": "def transpose_matrix(matrix):", "contract_group": "matrix_transpose", "tests": ["assert transpose_matrix([[1, 2, 3], [4, 5, 6], [7, 8, 9]]) == [[1, 4, 7], [2, 5, 8], [3, 6, 9]]", "assert transpose_matrix([[1], [2], [3]]) == [[1, 2, 3]]", "assert transpose_matrix([[1, 2], [3, 4], [5, 6]]) == [[1, 3, 5], [2, 4, 6]]", "assert transpose_matrix([[-4]]) == [[-4]]", "assert transpose_matrix([[0, -4]]) == [[0], [-4]]", "assert transpose_matrix([[1, -2, 4]]) == [[1], [-2], [4]]", "assert transpose_matrix([[-3, 0, 2, 2]]) == [[-3], [0], [2], [2]]", "assert transpose_matrix([[5], [-1]]) == [[5, -1]]", "assert transpose_matrix([[0, 5], [-5, -3]]) == [[0, -5], [5, -3]]", "assert transpose_matrix([[-3, -2, 2], [-5, -1, 3]]) == [[-3, -5], [-2, -1], [2, 3]]", "assert transpose_matrix([[-4, 3, -2, 5], [2, -1, -5, -4]]) == [[-4, 2], [3, -1], [-2, -5], [5, -4]]", "assert transpose_matrix([[0], [-4], [2]]) == [[0, -4, 2]]", "assert transpose_matrix([[-3, -4], [-1, 3], [5, -3]]) == [[-3, -1, 5], [-4, 3, -3]]", "assert transpose_matrix([[-4, -5, -1], [1, -5, 4], [3, 1, -5]]) == [[-4, 1, 3], [-5, -5, 1], [-1, 4, -5]]", "assert transpose_matrix([[2, -1, 1, 4], [1, -5, -1, -1], [-1, -4, 2, 4]]) == [[2, 1, -1], [-1, -5, -4], [1, -1, 2], [4, -1, 4]]", "assert transpose_matrix([[4], [-2], [4], [-3]]) == [[4, -2, 4, -3]]", "assert transpose_matrix([[-5, -5], [3, 4], [1, 1], [-3, -1]]) == [[-5, 3, 1, -3], [-5, 4, 1, -1]]", "assert transpose_matrix([[-4, 3, 1], [-4, 4, -4], [4, 1, -4], [-2, 3, 1]]) == [[-4, -4, 4, -2], [3, 4, 1, 3], [1, -4, -4, 1]]", "assert transpose_matrix([[2, 3, -1, 4], [0, -5, -1, 4], [-2, -4, 5, 5], [4, -1, -4, 0]]) == [[2, 0, -2, 4], [3, -5, -4, -1], [-1, -1, 5, -4], [4, 4, 5, 0]]"], "group_id": "9