{"task_id": "opencoder/22578728363", "source_seq_id": 22578728363, "instruction": "Write a function to find the length of the longest substring without repeating characters in a given string.", "reference": "def longest_substring_without_repeating_chars(s):\n    char_index_map = {}\n    left = 0\n    max_length = 0\n    for right in range(len(s)):\n        if s[right] in char_index_map:\n            left = max(left, char_index_map[s[right]] + 1)\n        char_index_map[s[right]] = right\n        max_length = max(max_length, right - left + 1)\n    return max_length", "entry_point": "longest_substring_without_repeating_chars", "signature": "def longest_substring_without_repeating_chars(s):", "contract_group": "longest_unique_substring_length", "tests": ["assert longest_substring_without_repeating_chars(\"au\") == 2", "assert longest_substring_without_repeating_chars(\" \") == 1", "assert longest_substring_without_repeating_chars(\"\") == 0", "assert longest_substring_without_repeating_chars(\"pwwkew\") == 3", "assert longest_substring_without_repeating_chars(\"bbbbb\") == 1", "assert longest_substring_without_repeating_chars(\"abcabcbb\") == 3", "assert longest_substring_without_repeating_chars('') == 0", "assert longest_substring_without_repeating_chars('a') == 1", "assert longest_substring_without_repeating_chars('aa') == 1", "assert longest_substring_without_repeating_chars('ab') == 2", "assert longest_substring_without_repeating_chars('aba') == 2", "assert longest_substring_without_repeating_chars('A a') == 3", "assert longest_substring_without_repeating_chars('A!a') == 3", "assert longest_substring_without_repeating_chars('12321') == 3", "assert longest_substring_without_repeating_chars('\u00e9a\u00e9') == 2", "assert longest_substring_without_repeating_chars('0B0a!ABAb9') == 5", "assert longest_substring_without_repeating_chars('bAa ') == 4", "assert longest_substring_without_repeating_chars('!') == 1", "assert longest_substring_without_repeating_chars('ab9\u00e