{"task_id": "opencoder/34478518852", "source_seq_id": 34478518852, "instruction": "Write a python function to count the number of vowels in a given string.", "reference": "def count_vowels(string):\n  count = 0\n  vowels = \"aeiou\"\n  for char in string.lower():\n    if char in vowels:\n      count += 1\n  return count", "entry_point": "count_vowels", "signature": "def count_vowels(string):", "contract_group": "count_vowels", "tests": ["assert count_vowels(\"beautiful\")==5", "assert count_vowels(\"world\")==1", "assert count_vowels(\"hello\")==2", "assert count_vowels('') == 0", "assert count_vowels('a') == 1", "assert count_vowels('aa') == 2", "assert count_vowels('ab') == 1", "assert count_vowels('aba') == 2", "assert count_vowels('A a') == 2", "assert count_vowels('A!a') == 2", "assert count_vowels('12321') == 0", "assert count_vowels('\u00e9a\u00e9') == 1", "assert count_vowels('bBB bAbAb?\u00e9') == 2", "assert count_vowels('\u00e9b0 ? 9') == 0", "assert count_vowels('A00a a\u00e9A\u00e90') == 4", "assert count_vowels('AB\u00e90?9?b') == 1", "assert count_vowels('B') == 0", "assert count_vowels('B0?b\u00e9!') == 0", "assert count_vowels('b  ?b !0') == 0", "assert count_vowels('a\u00e9a\u00e9 Ab') == 3", "assert count_vowels('\u00e99\u00e9b?!9B!') == 0", "assert count_vowels(' ') == 0", "assert count_vowels('a9??B ! ') == 1", "assert count_vowels('B0') == 0", "assert count_vowels('?\u00e9\u00e9A\u00e9\u00e9AbB') == 2", "assert count_vowels('9\u00e9B 9ba!\u00e9!ba') == 2", "assert count_vowels('BAa') == 2", "assert count_vowels('?9B ') == 0", "assert count_vowels('?9!b\u00e9b !B') == 0", "assert count_vowels('B\u00e9!!?B BAba') == 2", "assert count_vowels(' 9ab') == 1", "assert count_vowels('\u00e9A\u00e9!!0aB Aa') == 4", "assert count_vowels('9?0A9ba9?B') == 2", "assert count_vowels('b') == 0"], "group_id": "794100a06e183ae1acdcae0d4c770584f1700aa009b61cfbef7d8cd4e1c8a50b", "split": "train", "quality_tier": "independent_contract_checked", "independent_family":