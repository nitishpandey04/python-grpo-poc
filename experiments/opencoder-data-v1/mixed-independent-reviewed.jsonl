{"task_id": "opencoder/41418242529", "source_seq_id": 41418242529, "instruction": "Write a function to determine if a given list of numbers is strictly increasing.", "reference": "def is_strictly_increasing(lst):\n    for i in range(len(lst) - 1):\n        if lst[i] >= lst[i + 1]:\n            return False\n    return True", "entry_point": "is_strictly_increasing", "signature": "def is_strictly_increasing(lst):", "contract_group": "strictly_increasing", "tests": ["assert is_strictly_increasing([1, 2, 2, 3, 4]) == False", "assert is_strictly_increasing([1, 2, 3, 4, 5]) == True", "assert is_strictly_increasing([1, 3, 5, 7, 9]) == True", "assert is_strictly_increasing([10, 9, 8, 7, 6]) == False", "assert is_strictly_increasing([5, 6, 7, 8, 10]) == True", "assert is_strictly_increasing([1, 3, 3, 7, 9]) == False", "assert is_strictly_increasing([1]) == True", "assert is_strictly_increasing([1, 1]) == False", "assert is_strictly_increasing([2, 1]) == False", "assert is_strictly_increasing([3, 1, 2]) == False", "assert is_strictly_increasing([0]) == True", "assert is_strictly_increasing([0, 0]) == False", "assert is_strictly_increasing([-2, 1, -2, 3]) == False", "assert is_strictly_increasing([]) == True", "assert is_strictly_increasing([8, 7, 4, 8, 0, -4]) == False", "assert is_strictly_increasing([4, 6, 7, -2, 8]) == False", "assert is_strictly_increasing([6, 4, 0, -4, -3, 6, -3]) == False", "assert is_strictly_increasing([-3, 7]) == True", "assert is_strictly_increasing([2]) == True", "assert is_strictly_increasing([3, -1, -5, -2, 6, -4, 0, -1]) == False", "assert is_strictly_increasing([3, 4, 3, -2, -4, -4, -2]) == False", "assert is_strictly_increasing([7, 5, -3, 7, 8]) == False", "assert is_strictly_increasing([-2, -4, 1, -5, -3, -3]) == False", "assert is_strictly_increasing([-3, -2, -3, 0, 7, 7, -2, -2, 1]) == False", "assert is_strictly_increasing([-1, -4, 6, 6, -4, -4, 0, -3, 8, -2]) == False", "assert is_strictly_increasing([6]) == True", "assert is_strictly_inc