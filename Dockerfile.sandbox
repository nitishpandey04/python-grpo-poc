FROM python:3.12-slim
RUN pip install --no-cache-dir 'openenv==0.10.0' 'smolagents>=1.22,<2'
COPY vendor/coding_env/envs/coding_env /app/coding_env
COPY sandbox_worker.py /app/sandbox_worker.py
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1
WORKDIR /tmp
USER 65534:65534
CMD ["python", "-u", "/app/sandbox_worker.py"]
